{"nodes": [{"id": "index_deck_viewer", "label": "Deck walkthrough screen (index)", "file_type": "code", "source_file": "SAG Lab Design System/Floders/slides/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One screen that clicks through all nine frames in order with arrow keys or the pill nav, so the frame vocabulary is reviewed as a deck rather than as nine isolated cards; the footer keeps day + slide number visible throughout."}, {"id": "index_scale_to_fit", "label": "Scale-to-fit 1920x1080 stage harness", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/slides/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slides are authored at a fixed 1920x1080 canvas but reviewed in an arbitrary browser window, so fit() computes min(w/1920,(h-90)/1080), sizes the clipping box and CSS-scales the stage; transform-origin is top right because the deck is RTL, and it is re-run on load, resize and via ResizeObserver."}, {"id": "slides_rtl_logical_direction", "label": "RTL logical-direction contract for screens", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/slides/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every screen declares lang=ar dir=rtl on the document itself and positions chrome with logical properties (inset-inline-start, transform-origin top right) rather than left/right, so mirroring is inherited instead of hand-authored per slide."}], "edges": [{"source": "index_deck_viewer", "target": "slides_deck_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/slides/index.html", "source_location": null, "weight": 1.0}, {"source": "index_deck_viewer", "target": "slides_dscard_annotation", "relation": "implemen