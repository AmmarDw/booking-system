{"nodes": [{"id": "research_plan_doc", "label": "Research Plan (spikes R1-R4)", "file_type": "document", "source_file": "research_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_plan_r1", "label": "R1 - Google Meet vs Calendly-style meeting links", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved that a free personal Gmail CAN generate Meet links via the Calendar API under user-OAuth2; the 'Workspace required' limit applies only to the Admin SDK / service-account domain-wide-delegation path. Custom booking UI is preserved because Meet only returns a link string. Pulled early because it affects the schema, though implemented last (M6)."}, {"id": "research_plan_r2", "label": "R2 - Admin/provider dashboard patterns", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best practice found: calendar view with month/week/day toggle for overview plus a list/table view for detail, appointment cards showing service/consumer/time/status, colour-coding and multi-filter support; keep it simple and avoid clutter."}, {"id": "research_plan_r3", "label": "R3 - Landing-page sections + Claude Design prompts", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Social-proof section deliberately dropped from the internal blueprint baseline because an MVP has no testimonials to show."}, {"id": "research_plan_r4", "label": "R4 - Calendar UX: popup vs dedicated page", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule of thumb: flows with more than 3-4 steps or multi-field interaction belong on a dedicated page, not a modal; modals get clunky on mobile and are neither shareable nor crawlable."}, {"id": "research_plan_per_provider_google_decision", "label": "Decision: per-provider Google connection from the start", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R1 Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each provider does a one-time OAuth2 consent (calendar.events); the event is created on THEIR calendar with attendees=[consumer,provider] and sendUpdates=all, so the provider is the real host who can admit any edge-case knock, and the invited consumer joins directly with no waiting room."}, {"id": "research_plan_one_host_account_rejected", "label": "Rejected: single operator host-account model", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R1 Admittance mechanics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected because one operator calendar would own every meeting across all providers, the absent operator (not the attending provider) would be the organizer and the only person able to clear a waiting-room knock, plus poor data separation."}, {"id": "research_plan_google_calendar_api_conference_data", "label": "Google Calendar API events.insert + conferenceData.createRequest", "file_type": "document", "source_file": "research_plan.md", "source_location": "R1 Findings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "conferenceDataVersion=1 with a unique requestId and conferenceSolutionKey.type=hangoutsMeet returns the meeting URL as hangoutLink / conferenceData.entryPoints."}, {"id": "research_plan_meet_trusted_guest_admittance", "label": "Meet admittance: guests on the event list are 'Trusted'", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R1 Admittance mechanics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anyone whose email is on the event's guest list joins directly with no host present and no manual admit while the waiting room is off; uninvited emails must knock - therefore both provider and consumer must be added as attendees on every booking."}, {"id": "research_plan_oauth_test_user_mode", "label": "OAuth verification vs test-user mode", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R1 Findings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensitive Calendar scopes require Google OAuth verification for a public production app, but test-user mode is sufficient for the bootcamp demo."}, {"id": "research_plan_calendly_pattern", "label": "Calendly meeting-link pattern (comparison)", "file_type": "document", "source_file": "research_plan.md", "source_location": "R1 Findings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calendly OAuth-connects the user's Google Calendar and sets Meet as the event location so Google generates the link; disable Calendar's automatic Meet setting to avoid two links."}, {"id": "research_plan_shared_dashboard_decision", "label": "Decision: one shared dashboard for PROVIDER and ADMIN", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R2 Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same UI for both roles with the admin-only addition of a provider selector/filter; providers see only their own data. MVP pages kept to dashboard + services management + bulk-availability generator."}, {"id": "research_plan_landing_section_set", "label": "Landing section set (Hero -> How-it-works -> Services -> FAQ -> Footer)", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R3 Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MVP-appropriate section list with no social proof; the How-it-works section mirrors the documented user-journey text."}, {"id": "research_plan_dedicated_page_decision", "label": "Decision: dedicated /book/[serviceId] page (not a modal)", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R4 Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The flow is multi-step (date -> provider dropdowns -> slot -> confirm) and needs a real URL as a clean auth-redirect-back target."}, {"id": "research_plan_provider_gating_fallback", "label": "Provider gating + pasted fallback Meet link", "file_type": "rationale", "source_file": "research_plan.md", "source_location": "R1 Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A provider is not bookable until Google is connected; the fallback lets them paste a persistent personal Meet link so skipping OAuth does not block the product."}, {"id": "research_plan_common_blueprints", "label": "common_blueprints.md \u00a72 Landing Page Standard (internal)", "file_type": "document", "source_file": "research_plan.md", "source_location": "R3 Sources", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_plan_source_google_calendar_docs", "label": "Google Calendar API docs - create events with Meet", "file_type": "paper", "source_file": "research_plan.md", "source_location": "R1 Sources", "source_url": "https://developers.google.com/calendar/api/guides/create-events#video", "captured_at": null, "author": null, "contributor": null}, {"id": "research_plan_source_smashing_modal", "label": "Smashing Magazine - Modal vs Separate Page decision tree", "file_type": "paper", "source_file": "research_plan.md", "source_location": "R4 Sources", "source_url": "https://www.smashingmagazine.com/2026/03/modal-separate-page-ux-decision-tree/", "captured_at": null, "author": null, "contributor": null}, {"id": "research_plan_source_eleken_calendar_ui", "label": "Eleken - Calendar UI examples & UX tips", "file_type": "paper", "source_file": "research_plan.md", "source_location": "R2 Sources", "source_url": "https://www.eleken.co/blog-posts/calendar-ui", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "research_plan_doc", "target": "project_report_doc", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research_plan.md", "source_location": "header", "weight": 1.0}, {"source": "research_plan_doc", "target": "implementation_plan_doc", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research_plan.md", "source_location": "header", "weight": 1.0}, {"source": "research_plan_r1", "target": "project_report_fr_6", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "research_plan.md", "source_location": "R1", "weight": 1.0}, {"source": "research_plan_r1", "target": "project_report_fr_13", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "research_plan.md", "source_location": "R1", "weight": 1.0}, {"source": "research_plan_r1", "target": "project_report_fr_5", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "research_plan.md", "source_location": "R1 (Gmail SMTP + app password finding)", "weight": 1.0}, {"source": "research_plan_r1", "target": "research_plan_google_calendar_api_conference_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research_plan.md", "source_location": "R1 Findings", "weight": 1.0}, {"source": "research_plan_r1", "target": "research_plan_meet_trusted_guest_admittance", "relation": "references", "confidence": "EXTRACTED", "