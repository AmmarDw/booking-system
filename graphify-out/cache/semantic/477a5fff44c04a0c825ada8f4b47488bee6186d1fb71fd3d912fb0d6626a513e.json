{"nodes": [{"id": "render_blueprint", "label": "Render Blueprint (render.yaml)", "file_type": "code", "source_file": "render.yaml", "source_location": "L1-56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Infrastructure-as-code Blueprint so the backend + managed Postgres can be imported into Render in one step instead of hand-wiring the dashboard."}, {"id": "render_bookit_db", "label": "bookit-db (Render managed Postgres, free plan, oregon)", "file_type": "code", "source_file": "render.yaml", "source_location": "L1-4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managed Postgres on the free tier, pinned to the same region as the backend to keep DB latency low."}, {"id": "render_bookit_backend", "label": "bookit-backend (Render docker web service, free plan, oregon)", "file_type": "code", "source_file": "render.yaml", "source_location": "L7-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker runtime rather than a native Java runtime, so the JVM/Maven build is reproducible from the repo Dockerfile."}, {"id": "render_dockerfile_path", "label": "dockerfilePath / dockerContext -> ./app/backend", "file_type": "code", "source_file": "render.yaml", "source_location": "L12-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monorepo: the docker context is scoped to the backend subfolder so the frontend is not shipped into the backend image."}, {"id": "render_healthcheckpath", "label": "healthCheckPath: /api/services", "file_type": "code", "source_file": "render.yaml", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A public, DB-backed GET endpoint is used as the liveness probe, so a green health check also proves the datasource is reachable."}, {"id": "render_db_env_group", "label": "DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD (fromDatabase: bookit-db)", "file_type": "code", "source_file": "render.yaml", "source_location": "L16-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connection values are injected by Render from the linked database rather than typed in, so no DB credential ever lives in the repo. Values are managed by Render and not present in source (redacted)."}, {"id": "render_google_redirect_uri", "label": "GOOGLE_REDIRECT_URI (pinned https://bookit-backend.onrender.com/api/google/oauth2/callback)", "file_type": "code", "source_file": "render.yaml", "source_location": "L36-39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit comment: the URL is deterministic because the service name is pinned, so the OAuth redirect can be committed rather than filled in after the first deploy."}, {"id": "render_sync_false_secrets", "label": "sync:false secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY, JWT_SECRET, EMAIL_USER, EMAIL_PASS)", "file_type": "code", "source_file": "render.yaml", "source_location": "L40-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sync:false declares the key without a value so the Blueprint import prompts for it; secret VALUES are deliberately absent from the repo (redacted)."}, {"id": "render_app_cors_origins", "label": "APP_CORS_ORIGINS (sync:false, set to the Vercel URL post-deploy)", "file_type": "code", "source_file": "render.yaml", "source_location": "L52-55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declared as a placeholder so the import prompts for it; the real frontend origin is only known after the Vercel deploy. Value redacted/not in source."}], "edges": [{"source": "render_blueprint", "target": "render_bookit_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "render.ya