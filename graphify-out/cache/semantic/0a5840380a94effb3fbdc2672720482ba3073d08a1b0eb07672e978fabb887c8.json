{"nodes": [{"id": "colors_text_brand_ink", "label": "--brand-ink (body text)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The body text colour, always at full opacity. Ink on white measures 8.6:1. Backs both --text-body and --text-caption."}, {"id": "colors_text_no_grey_rule", "label": "Rule: no grey text on white", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light grey (#9AA3B4) on white is marked forbidden -- 'projector eats this'. Two sanctioned pairings only: full-opacity ink on white (8.6:1) and white on deep (14:1). De-emphasis must come from size or weight, never from lowering contrast."}], "edges": [{"source": "colors_text_no_grey_rule", "target": "colors_text_brand_ink", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/colors-text.html", "source_location": null, "weight": 1.0}, {"source": "colors_text_brand_ink", "target": "colors_surfaces_brand_white", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/colors-text.html", "source_location": null, "weight": 1.0}, {"source": "colors_semantic_text_invert", "target": "colors_brand_deep", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SAG Lab Design System/Floders/guidelines/colors-text.html", "source_location": null, "weight": 1.0}, {"source": "colors_text_no_grey_rule", "target": "type_scale_table", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SAG Lab Design System/Floders/guidelines/color