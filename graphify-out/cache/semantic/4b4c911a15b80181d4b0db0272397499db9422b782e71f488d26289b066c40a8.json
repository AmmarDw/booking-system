{"nodes": [{"id": "skill_bootcamp_setup", "label": "Skill: bootcamp-setup (tooling & MCP wiring, task 7.10)", "file_type": "document", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "frontmatter + full body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude executes everything doable from the CLI; only identity-bound steps (accounts, key copying, browser OAuth) are left to the trainee."}, {"id": "skill_task_7_10_connect_integrations", "label": "Task 7.10 - create the Supabase project and connect the MCP integrations", "file_type": "document", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "whole skill", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_tool_context7", "label": "Tool: context7 MCP (user scope, ctx7sk- key, connected before any coding)", "file_type": "document", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches up-to-date library/framework docs so generated code matches current versions; user scope because it helps all the trainee's projects, and a key avoids the anonymous rate limit."}, {"id": "skill_tool_supabase", "label": "Tool: Supabase project (Postgres + built-in auth, Free plan)", "file_type": "document", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives a database and a ready-made login system together, with no Docker and no local install, and behaves identically in dev and after deployment. The DB password is shown once only - copy and store it now."}, {"id": "skill_tool_supabase_mcp", "label": "Tool: Supabase MCP (project scope, OAuth, read-only off, Storage off)", "file_type": "document", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets Claude create tables and read DB logs directly so the trainee never opens the Supabase console to write SQL; project scope (or project_ref) keeps his other projects out of reach and no personal access token is needed."}, {"id": "skill_tool_chrome_devtools", "label": "Tool: chrome-devtools MCP (connected at task 14.2, browser testing)", "file_type": "document", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred out of day 1 to spread setup effort; every connected integration inflates every message and burns the trainee's credit."}, {"id": "skill_rule_secret_handling", "label": "Rule: a pasted key goes into the command or .env only, never echoed, .env in .gitignore", "file_type": "rationale", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write 'key received' in the history instead of the value; the document-everything rule does not cover secrets."}, {"id": "skill_rule_tools_table_incremental", "label": "Rule: add each newly used tool to PRODUCT.md section 10 immediately, not at the end", "file_type": "rationale", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_rule_claude_cli_trainee_identity", "label": "Boundary table: Claude runs the CLI, the trainee does identity-bound steps (/mcp Authenticate)", "file_type": "rationale", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The interactive browser OAuth flow needs the trainee's own identity and cannot be executed by Claude; detect the OS before issuing any command instead of assuming Windows or macOS."}, {"id": "skill_warning_mcp_restart_required", "label": "Warning: a newly added MCP server does not work in the current session - restart Claude Code", "file_type": "rationale", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 1 blockquote", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you do not say this, the trainee will read the normal state as a failed connection."}, {"id": "skill_rule_supabase_project_before_mcp", "label": "Ordering rule: create the Supabase project before wiring the Supabase MCP", "file_type": "rationale", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The MCP needs an existing project to point at; verify the link afterwards by actually querying his tables."}, {"id": "skill_rule_defer_integrations_context_cost", "label": "Rule: defer chrome-devtools (14.2) and Vercel MCP (16.2) - each connection inflates every message", "file_type": "rationale", "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skill_bootcamp_setup", "target": "skill_task_7_10_connect_integrations", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/bootcamp-setup/SKILL.md", "source_location": "frontmatter + intro", "weight": 1.0}, {"source": "skill_bootcamp_setup", "target": "skill_rule_claude_cl