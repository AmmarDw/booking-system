{"nodes": [{"id": "skill_designing_screens", "label": "Skill: designing-screens (section 12, tasks 12.1-12.4)", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "frontmatter + full body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only design-system components cross into the project; generated screens stay visual references, so the skill pushes for a rich design system."}, {"id": "skill_task_12_1_screen_inventory", "label": "Task 12.1 - screen inventory (name, path, who reaches it)", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_12_2_design_prompts", "label": "Task 12.2 - Claude writes the design prompts, not the trainee", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_12_3_design_system", "label": "Task 12.3 - build the design system first", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_12_4_screen_generation", "label": "Task 12.4 - generate screens, a fresh chat per screen with the system selected", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "sections 3.1-3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_tool_claude_design", "label": "Tool: Claude Design (design system + screen generation)", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "whole skill", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_tool_design_sync", "label": "Tool: DesignSync (/design-sync - pulls one component at a time)", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 0", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_warning_designsync_components_not_screens", "label": "Hard limit: DesignSync moves components, generated screens never transfer", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Technical and not negotiable - so push for a rich design system, since components are the only thing that crosses into the project. Never promise the screens will be imported."}, {"id": "skill_rule_design_system_project_type_immutable", "label": "Rule: the Claude Design project must be of type Design System - the type is fixed at creation", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A normal project can never become a design system; catch it now, not a week later - it is a late-discovered mistake that costs a rebuild."}, {"id": "skill_rule_claude_writes_design_prompts", "label": "Rule: Claude writes the design prompts (system prompt + one per screen, identical token values)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screens generated with different values come out inconsistent; list the components explicitly instead of saying 'ready-made components'."}, {"id": "skill_rule_research_screen_conventions", "label": "Rule: research established conventions before prompting (landing, dashboard, pricing)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A minute of research beats three correction rounds; in the real build research changed the landing-page section list and dropped the testimonials section because an MVP has no customers yet."}, {"id": "skill_warning_copy_design_form_answers", "label": "Mandatory: ask the trainee to copy his answers to Claude Design's questions", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You only know what you prompted; details the trainee added in the form look like noise at build time and get discarded - exactly the decisions he took deliberately get lost. Ask before generation and again after each screen."}, {"id": "skill_concept_screen_delivery_link_then_download", "label": "Delivery: share link by default, download screen files when one of three conditions hits", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ask for the download yourself when your result does not match his description, when the screen has many states (a calendar), or when it is crowded - do not wait for him to diagnose it. Clean up design-temp/ after building."}, {"id": "skill_concept_visual_states_vs_behavior", "label": "Split: Claude Design draws visual states, behaviour and logic are built in code", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real calendar was designed with its visual states (year/month pick, disabled cells, pressure colouring) while navigation logic and the booking horizon were implemented later in code - do not stuff behaviour into a design prompt."}, {"id": "skill_rule_screen_traces_to_origin", "label": "Rule: every screen must trace back to a journey step or a requirement", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Record name, path and who reaches it - the last one becomes a permission constraint at task 14.3, so never leave it blank."}], "edges": [{"source": "skill_designing_screens", "target": "skill_task_12_1_screen_inventory", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 1", "weight": 1.0}, {"source": "skill_designing_screens", "target": "skill_task_12_2_design_prompts", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 2", "weight": 1.0}, {"source": "skill_designing_screens", "target": "skill_task_12_3_design_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "section 3", "weight": 1.0}, {"source": "skill_designing_screens", "target": "skill_task_12_4_screen_generation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/designing-scree