{"nodes": [{"id": "skill_building_features", "label": "Skill: building-features (section 14 seven tasks + section 13 modelling)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "frontmatter + full body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude builds and tests; the trainee steers, approves and tries the UI. Plan mode plus a jargon-free summary precede every task."}, {"id": "skill_section_13_data_model", "label": "Curriculum section 13 - data model (owned by building-features)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C, modelling blockquote", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_1_scaffold_and_repo", "label": "Task 14.1 - scaffold, GitHub repo, login page opens (day 1)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section B", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_2_data_model_tables", "label": "Task 14.2 - create the tables, connect chrome-devtools first (day 6)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_3_roles_permissions", "label": "Task 14.3 - roles and permissions, enforced server-side (day 7)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section D", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_4_public_browsing", "label": "Task 14.4 - landing page and public browsing (day 7)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section E", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_5_core_feature", "label": "Task 14.5 - the product's core journey end to end (day 8, heaviest task)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section F", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_6_dashboard", "label": "Task 14.6 - dashboard and admin CRUD, role-scoped (day 9)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section G", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_14_7_external_service", "label": "Task 14.7 - conditional external-service integration (day 9)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section H", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_tool_github", "label": "Tool: GitHub repository (created at task 14.1)", "file_type": "document", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section B", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_principle_testing_is_claudes_job", "label": "Rule: testing is Claude's job after every feature", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section A", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_rule_plan_mode_plain_summary", "label": "Rule: plan mode plus a jargon-free 'what we build now' summary before every task", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_cycle_single_feature_loop", "label": "Cycle: design-sync a piece, build UI+server wired to the DB, test, trainee tries, commit", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never build a whole task in one go - feature by feature, committing after each one and not only at day end."}, {"id": "skill_testing_three_layers", "label": "Three test layers after every feature: repeatable automated cases, CLI checks, chrome-devtools browser walk", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Then report non-technically; stop any test server explicitly so the trainee does not hit a port-occupied error when he runs the app himself."}, {"id": "skill_github_repo_form_guidance", "label": "Repo creation: leave README / .gitignore / license unchecked (merge-conflict warning)", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub's own docs warn that selecting them when pushing an existing project creates a merge conflict; Claude creates those files locally instead. Private is enough, and the repo URL goes into CLAUDE.md."}, {"id": "skill_concept_entities_from_requirements", "label": "Modelling: extract entities from requirements and roles - ask what the system must remember", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C blockquote", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys and join tables are Claude's job, not the trainee's - create the join table and explain it in one sentence rather than passing it silently. Explain every entity in a sentence so he knows what he is approving. Common modelling errors: an entity that stores nothing meaningful, a relation with no defined type, a table created for a single value that settings could hold."}, {"id": "skill_warning_erd_empty_boxes", "label": "Warning: open every ERD box and confirm its fields are written inside before showing it", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C blockquote", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the real build some boxes came out empty while the diagram looked fine from a distance - correct structure, missing content."}, {"id": "skill_rule_redraw_erd_from_tables", "label": "Rule: after creating the tables, redraw the ERD from the real tables, not from the written model", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C blockquote", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A diagram that does not match reality is worse than none, because the trainee will trust it while it is wrong."}, {"id": "skill_warning_no_error_is_not_success", "label": "Warning: no error message does not mean it worked - verify the output itself", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C warning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In a real build the table-provisioning tool never ran at all and emitted no error, so the database stayed empty and it was found only by looking inside it."}, {"id": "skill_rule_server_side_permission_enforcement", "label": "Rule: enforce restrictions on the server, not by hiding UI elements", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section D", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hiding a button does not stop the function being called directly; test with every role and try a forbidden page as each of them. Ask explicitly for every logical rule: can role X do something it makes no sense for it to do?"}, {"id": "skill_warning_403_not_500", "label": "Warning: a permission denial must return the right forbidden code, not a generic 500", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section D warning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the real build the block worked but reported the wrong thing - the denial surfaced as a server error."}, {"id": "skill_warning_native_date_inputs_os_locale", "label": "Warning: native date/time/number inputs render in the OS language - use text fields with a fixed pattern", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section F warning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arabic digits and month names appeared on an Arabic machine; use YYYY-MM-DD text inputs with simple validation. Restated in testing-and-security 2.3 as something only a browser test reveals."}, {"id": "skill_rule_return_to_origin_after_login", "label": "Rule: if login is demanded mid-flow, return the user to where he was", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section E", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also decide explicitly what a signed-out visitor sees, and test in a signed-out session rather than your own signed-in one."}, {"id": "skill_rule_split_confusing_manual_steps", "label": "Rule: external-service console steps get numbered clicks and every term explained; on confusion split further", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section H", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trainer literally said 'I did not understand you at all' twice in a row at this stage - never assume he knows what an OAuth client, a scope or a redirect URI is, and never just re-word the same explanation."}, {"id": "skill_rule_expect_gaps_after_first_integration", "label": "Rule: after the first successful integration expect gaps - walk the whole journey, not just the connection", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section H", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typical misses: a notification to the second party, a redirect after completion, a missing field in a message. If the product needs no external service, say so explicitly and spend the time on remaining scope instead of inventing an integration."}, {"id": "skill_rule_expect_corrections_after_dashboard", "label": "Rule: expect corrections once the dashboard is seen - treat them as part of building", "file_type": "rationale", "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the real build the trainer asked to hide a whole page from two roles after seeing it; seeing the dashboard reveals what discussion does not."}], "edges": [{"source": "skill_building_features", "target": "skill_task_14_1_scaffold_and_repo", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section B", "weight": 1.0}, {"source": "skill_building_features", "target": "skill_task_14_2_data_model_tables", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section C", "weight": 1.0}, {"source": "skill_building_features", "target": "skill_task_14_3_roles_permissions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section D", "weight": 1.0}, {"source": "skill_building_features", "target": "skill_task_14_4_public_browsing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section E", "weight": 1.0}, {"source": "skill_building_features", "target": "skill_task_14_5_core_feature", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section F", "weight": 1.0}, {"source": "skill_building_features", "target": "skill_task_14_6_dashboard", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section G", "weight": 1.0}, {"source": "skill_building_features", "target": "skill_task_14_7_external_service", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/building-features/SKILL.md", "source_location": "section H", "weight": 1.0}, {"source": "skill_building_features", "target": "skil