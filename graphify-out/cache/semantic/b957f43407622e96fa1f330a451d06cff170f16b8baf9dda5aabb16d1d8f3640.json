lation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_curriculum_md", "target": "bootcampdeck_template", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_ltr_exceptions", "target": "split_slidesplit", "relation": "semantically_similar_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "docx_two_step_rtl_build", "label": "Two-step Markdown to RTL .docx build", "nodes": ["readme_docx_pipeline", "readme_build_js", "readme_raw_docx", "readme_rtl_patch_py", "readme_curriculum_md", "readme_curriculum_docx", "readme_rtl_trap", "readme_verification"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md"}]}