{"nodes": [{"id": "readme_docx_pipeline", "label": "Curriculum docx build pipeline", "file_type": "document", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two steps, both required: a JS generator cannot express the OOXML that Word needs for correct RTL, so a Python post-patch is a mandatory second pass rather than an optional polish."}, {"id": "readme_curriculum_md", "label": "bootcamp_roadmap_and_curriculum.md (source)", "file_type": "document", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_raw_docx", "label": "raw.docx intermediate", "file_type": "document", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never the deliverable - it is the un-patched hand-off between the two required steps."}, {"id": "readme_curriculum_docx", "label": "bootcamp_roadmap_and_curriculum.docx (output)", "file_type": "document", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_rtl_trap", "label": "The OOXML RTL trap (w:jc is start/end)", "file_type": "rationale", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "w:jc in OOXML is logical start/end, not physical left/right: inside a paragraph carrying w:bidi, w:jc=right means end, which renders on the LEFT. So bidirectional:true together with alignment:RIGHT produces left-aligned Arabic - the exact bug the two-script pair exists to fix."}, {"id": "readme_omit_jc_rule", "label": "Rule: bidi paragraphs omit w:jc entirely", "file_type": "rationale", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTL paragraphs set w:bidi and write no justification at all, because the default (start) already resolves to right under bidi - stating alignment can only re-introduce the trap."}, {"id": "readme_patch_sectpr_bidi", "label": "Patch: w:bidi in sectPr", "file_type": "code", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sets section/page reading order; without it tab stops and table column order stay LTR even when the paragraphs are right."}, {"id": "readme_patch_docdefaults_bidi", "label": "Patch: w:bidi + w:rtl in docDefaults", "file_type": "code", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes anything unstyled inherit RTL instead of falling back to LTR."}, {"id": "readme_patch_normal_style", "label": "Patch: define a real RTL Normal style", "file_type": "code", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "docx-js emits headings with basedOn=Normal but never defines Normal, so the inheritance chain dangles until the patch supplies it."}, {"id": "readme_patch_toc_styles", "label": "Patch: RTL TOC1-TOC3 styles", "file_type": "code", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Word builds TOC entries from these styles at open time, so they have to already be RTL in styles.xml - patching the document body is too late."}, {"id": "readme_jc_strip_guard", "label": "Guard: strip w:jc=right from bidi paragraphs", "file_type": "code", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defensive sweep in case any physical justification survived generation - the failure it prevents is silent, so it is cheaper to always strip."}, {"id": "readme_ltr_exceptions", "label": "Deliberate LTR exceptions", "file_type": "rationale", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directory trees (detected by the box-drawing characters) and shell commands stay LTR because mirroring them destroys their meaning; Arabic prose inside fenced blocks is still rendered RTL."}, {"id": "readme_verification", "label": "Structural verification check", "file_type": "code", "source_file": "tools/docx/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No LibreOffice or pdftoppm on the machine, so there is no visual render step; correctness is proved structurally instead - heading and table counts must match the Markdown and the count of w:jc=right must be exactly 0."}], "edges": [{"source": "readme_docx_pipeline", "target": "readme_build_js", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_docx_pipeline", "target": "readme_rtl_patch_py", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_docx_pipeline", "target": "readme_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_build_js", "target": "readme_curriculum_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_build_js", "target": "readme_raw_docx", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_rtl_patch_py", "target": "readme_raw_docx", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_rtl_patch_py", "target": "readme_curriculum_docx", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_rtl_trap", "target": "readme_rtl_patch_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_rtl_trap", "target": "readme_omit_jc_rule", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_omit_jc_rule", "target": "readme_jc_strip_guard", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_omit_jc_rule", "target": "readme_build_js", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_rtl_patch_py", "target": "readme_patch_sectpr_bidi", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/docx/README.md", "source_location": null, "weight": 1.0}, {"source": "readme_rtl_patch_py", "target": "readme_patch_docdefaults_bidi", "relation": "implements", "confidence": "EXTRACTED", "confiden