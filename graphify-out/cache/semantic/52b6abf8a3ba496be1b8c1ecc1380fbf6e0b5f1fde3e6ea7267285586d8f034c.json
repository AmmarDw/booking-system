{"nodes": [{"id": "type_mixed_rule", "label": "Rule: wrap every Latin fragment in an RTL line", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Latin words and commands inside Arabic text must be wrapped in .tok-lat / .tok-code so they cannot reorder the line. Unwrapped, the bidi algorithm moves punctuation and slashes to the wrong end and 'the line breaks apart' -- shown side by side on the card."}, {"id": "type_mixed_tok_lat", "label": ".tok-lat (Latin fragment wrapper)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapper for Latin words inside Arabic prose, e.g. 'Claude Code'. Isolates the run so it keeps its own direction."}, {"id": "type_mixed_tok_code", "label": ".tok-code (inline command wrapper)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapper for inline commands and slash-commands inside Arabic prose, e.g. '/init'. Without it the leading slash jumps to the wrong end of the phrase."}], "edges": [{"source": "type_mixed_rule", "target": "rtl_logical_properties_rule", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "weight": 1.0}, {"source": "type_mixed_tok_lat", "target": "type_mixed_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "weight": 1.0}, {"source": "type_mixed_tok_code", "target": "type_mixed_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "weight": 1.0}, {"source": "type_mixed_tok_code", "target": "type_caption_mono_font_mono", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "SAG Lab Design System/Floders/guidelines/type-mixed.html", "source_location": null, "weight": 1.0}], "hyperedges": []}