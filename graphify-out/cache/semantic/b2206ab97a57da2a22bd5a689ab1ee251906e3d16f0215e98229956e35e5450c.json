LL.md", "source_location": "L167-171", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_12_4_screen_generation", "label": "Task 12.4 \u2014 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0634\u0627\u0634\u0627\u062a: \u0645\u062d\u0627\u062f\u062b\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u0643\u0644 \u0634\u0627\u0634\u0629", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L165-211", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_tool_claude_design", "label": "Tool: Claude Design (\u0646\u0638\u0627\u0645 \u062a\u0635\u0645\u064a\u0645 + \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0634\u0627\u0634\u0627\u062a)", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L8-10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_tool_design_sync", "label": "\u0623\u062f\u0627\u0629 DesignSync (\u0628\u064a\u062f\u0643): \u062a\u0642\u0631\u0623 \u0645\u0644\u0641\u0651\u0627\u062a Claude Design \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639", "file_type": "document", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L16-34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_slash_design_sync_command", "label": "/design-sync (\u0623\u0645\u0631): \u064a\u0631\u0641\u0639 \u0645\u0643\u062a\u0628\u0629 \u0643\u0648\u062f \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 \u2014 \u0645\u0645\u0646\u0648\u0639 \u0647\u0646\u0627", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L23-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same name, opposite direction (repo to Claude Design, needs .storybook or *.stories.*); confusing the two cost a real build three correction rounds. The course design system was born inside Claude Design, so there is no code library to upload."}, {"id": "designing_screens_skill_design_login_trainee_step", "label": "/design-login \u062e\u0637\u0648\u0629 \u0627\u0644\u0645\u062a\u062f\u0631\u0651\u0628 \u0644\u0627 Claude (\u064a\u062d\u062a\u0627\u062c \u0633\u0637\u0631 \u0623\u0648\u0627\u0645\u0631 \u062a\u0641\u0627\u0639\u0644\u064a\u064b\u0627)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L33-34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_transfer_matrix", "label": "\u0645\u0627 \u064a\u0646\u062a\u0642\u0644 \u0648\u0645\u0627 \u0644\u0627: \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0648\u0631\u0645\u0648\u0632\u0647\u0627 \u062a\u064f\u0642\u0631\u0623\u060c \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u0627\u0644\u0645\u0648\u0644\u0651\u062f\u0629 \u062a\u064f\u0646\u0632\u064e\u0651\u0644", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L16-21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_warning_designsync_components_not_screens", "label": "Hard limit: DesignSync moves components, generated screens never transfer", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L20-21,43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_rule_design_system_project_type_immutable", "label": "Rule: the Claude Design project must be of type Design System \u2014 fixed at creation", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L36-37,233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool reads only Design System projects; an ordinary project cannot be read whatever Claude does, and discovering it late costs re-creation."}, {"id": "designing_screens_skill_push_rich_design_system", "label": "\u0627\u062f\u0641\u0639 \u0627\u0644\u0645\u062a\u062f\u0631\u0651\u0628 \u0646\u062d\u0648 \u0646\u0638\u0627\u0645 \u062a\u0635\u0645\u064a\u0645 \u063a\u0646\u064a\u0651 (\u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0648\u062d\u062f\u0647\u0627 \u062a\u0646\u062a\u0642\u0644)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_pull_whole_system_once", "label": "\u0627\u0633\u062d\u0628 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0643\u0627\u0645\u0644\u064b\u0627 \u0645\u0631\u0651\u0629 \u0648\u0627\u062d\u062f\u0629 \u0644\u0627 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L20,231", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_extract_inventory_automatically", "label": "Claude \u064a\u0633\u062a\u062e\u0631\u062c \u0627\u0644\u062c\u0631\u062f \u0645\u0646 \u0627\u0644\u0631\u062d\u0644\u0629 (\u00a74) \u0648\u0627\u0644\u0645\u062a\u0637\u0644\u0651\u0628\u0627\u062a (\u00a73) \u0644\u0627 \u0645\u0646 \u0630\u0627\u0643\u0631\u062a\u0647", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L49-59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This was the only course task asking the trainee to hand-write something formal, which violated the working charter section 7."}, {"id": "designing_screens_skill_screen_six_fields", "label": "\u0633\u062a\u0651\u0629 \u062d\u0642\u0648\u0644 \u0644\u0643\u0644 \u0634\u0627\u0634\u0629: \u0627\u0644\u0627\u0633\u0645 \u00b7 \u0627\u0644\u0645\u0633\u0627\u0631 \u00b7 \u0643\u064a\u0641 \u062a\u064f\u0641\u062a\u062d \u00b7 \u0645\u0646 \u064a\u0635\u0644 \u00b7 \u0623\u0642\u0633\u0627\u0645\u0647\u0627 \u00b7 \u0623\u0635\u0644\u0647\u0627", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Who reaches it' becomes a permissions constraint in task 14.3 so it must not be left empty; sections are only a name and one line here, detail comes in 12.2."}, {"id": "designing_screens_skill_four_part_presentation", "label": "\u0639\u0631\u0636 \u0623\u0631\u0628\u0639\u0629 \u0623\u062c\u0632\u0627\u0621: \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u0628\u0623\u0635\u0644\u0647\u0627 \u00b7 \u0627\u0644\u0641\u062c\u0648\u0627\u062a \u00b7 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u0627\u062a \u00b7 \u062a\u0646\u0628\u064a\u0647 \u0645\u062d\u062f\u0648\u062f\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L61-66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The warning that extraction is limited to what he wrote turns his review from 'does it look right' into 'what did I never write'."}, {"id": "designing_screens_skill_close_gaps_with_questions", "label": "\u0623\u063a\u0644\u0642 \u0643\u0644 \u0641\u062c\u0648\u0629 \u0641\u0648\u0631\u064b\u0627 \u0628\u0640AskUserQuestion \u0628\u062e\u064a\u0627\u0631\u0627\u062a (2\u20134): \u0634\u0627\u0634\u0629 \u0645\u0633\u062a\u0642\u0644\u0651\u0629 \u00b7 \u0642\u0633\u0645 \u00b7 \u0628\u0644\u0627 \u0648\u0627\u062c\u0647\u0629", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L68-83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaving the gap list shown re-creates the manual matching burden that automatic extraction was designed to remove; closing every discoverable gap leaves the trainee only the unwritten ones."}, {"id": "designing_screens_skill_ask_only_when_set_changes", "label": "\u0627\u0633\u0623\u0644 \u0641\u0642\u0637 \u062d\u064a\u0646 \u062a\u062a\u063a\u064a\u0651\u0631 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0634\u0627\u0634\u0627\u062a\u061b \u063a\u064a\u0631 \u0630\u0644\u0643 \u0642\u0631\u0651\u0631 \u0648\u0633\u062c\u0651\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L85-89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A medium project has dozens of small questions; asking each rebuilds the manual burden. Phrase in product language, not screen structure."}, {"id": "designing_screens_skill_origin_two_cases", "label": "\u0623\u0635\u0644 \u0627\u0644\u0634\u0627\u0634\u0629 \u062d\u0627\u0644\u062a\u0627\u0646: \u0627\u0633\u062a\u062e\u0631\u062c\u0647\u0627 Claude (\u064a\u064f\u062a\u062a\u0628\u064e\u0651\u0639) \u00b7 \u0623\u0636\u0627\u0641\u0647\u0627 \u0627\u0644\u0645\u062a\u062f\u0631\u0651\u0628 (\u064a\u064f\u062e\u062a\u0628\u064e\u0631)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L91-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflating them was a shipped mistake: 'any screen you added needs an origin' describes an action (trainee addition) that has not yet happened at review time."}, {"id": "skill_rule_screen_traces_to_origin", "label": "Rule: every screen must trace back to a journey step or requirement", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L93-97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trainee-added full screen without an origin is not dropped: propose the requirement that justifies it, revealing missing requirements."}, {"id": "designing_screens_skill_three_pass_review", "label": "\u0645\u0631\u0627\u062c\u0639\u0629 \u062b\u0644\u0627\u062b \u0645\u0631\u0651\u0627\u062a: \u0631\u062d\u0644\u062a\u0647 \u2190 \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u00b7 \u0645\u062a\u0637\u0644\u0651\u0628\u0627\u062a\u0647 \u2190 \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u00b7 \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u2190 \u0623\u0635\u0644\u0647\u0627", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L101-105", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_visual_identity_elicitation", "label": "\u0627\u0644\u0647\u0648\u064a\u0651\u0629 \u0627\u0644\u0628\u0635\u0631\u064a\u0629: \u0623\u0644\u0648\u0627\u0646 hex \u0645\u0631\u062a\u0651\u0628\u0629 \u0628\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u00b7 \u062e\u0637 \u00b7 \u0642\u0631\u0627\u0631 RTL/LTR", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L112-124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A palette image forces guessing codes and leaves the primary colour ambiguous; point him to colorhunt.co / coolors.co image-picker / fonts.google.com and ask explicitly about Arabic RTL support."}, {"id": "designing_screens_skill_last_gap_question", "label": "\u0627\u0644\u0641\u062c\u0648\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u2014 \u0623\u0647\u0645\u0651 \u0633\u0624\u0627\u0644: \u0627\u0646\u0638\u0631 \u0644\u0642\u0627\u0626\u0645\u0629 \u0634\u0627\u0634\u0627\u062a\u0643 \u0623\u0646\u062a", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L126-142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the trainee holds what is written nowhere; a generic 'anything to add?' is wrong, ask him to look at his own screen list; never skip it as optional."}, {"id": "skill_rule_research_screen_conventions", "label": "Rule: research established screen conventions before prompting", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L59,155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the real build research dropped the testimonials section from the landing page because the product had no customers yet."}, {"id": "skill_rule_claude_writes_design_prompts", "label": "Rule: Claude writes the prompts (system prompt + one per screen, identical values)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L146-153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screens must carry the same token values literally or they come out inconsistent."}, {"id": "designing_screens_skill_system_prompt_names_components", "label": "\u0623\u0645\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u064a\u0633\u0631\u062f \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0635\u0631\u0627\u062d\u0629\u064b (\u0632\u0631 \u0628\u062d\u0627\u0644\u0627\u062a\u0647\u060c \u062d\u0642\u0644\u060c \u0628\u0637\u0627\u0642\u0629\u060c \u0646\u0627\u0641\u0630\u0629\u060c \u062c\u062f\u0648\u0644\u060c \u062a\u0646\u0628\u064a\u0647)", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_detail_sections_before_prompt", "label": "\u0641\u0635\u0651\u0644 \u062a\u0631\u062a\u064a\u0628 \u0643\u0644 \u0642\u0633\u0645 \u0648\u0645\u062d\u062a\u0648\u0627\u0647 \u0648\u062d\u0627\u0644\u0627\u062a\u0647 (\u0641\u0627\u0631\u063a/\u0645\u0639\u0628\u0651\u0623/\u062e\u0637\u0623) \u0642\u0628\u0644 \u0623\u0645\u0631 \u0634\u0627\u0634\u062a\u0647", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_screens_skill_write_prompts_into_product_md", "label": "\u0627\u0643\u062a\u0628 \u0643\u0644 \u0623\u0645\u0631 \u0641\u064a PRODUCT.md \u00a75 \u0641\u0648\u0631 \u0643\u062a\u0627\u0628\u062a\u0647", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L159-161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps prompts available in 12.3 and 12.4 even after a new conversation."}, {"id": "designing_screens_skill_select_design_system_each_screen", "label": "\u0644\u0643\u0644 \u0634\u0627\u0634\u0629: \u0645\u062d\u0627\u062f\u062b\u0629 \u062c\u062f\u064a\u062f\u0629 \u2190 \u0627\u062e\u062a\u064a\u0627\u0631 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u2190 \u0644\u0635\u0642 \u0623\u0645\u0631\u0647\u0627", "file_type": "rationale", "source_file": "project-package/.claude/skills/designing-screens/SKILL.md", "source_location": "L167-171", "s