{"nodes": [{"id": "colors_semantic_surface_slide", "label": "--surface-slide", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-white. The default light slide background."}, {"id": "colors_semantic_surface_slide_dark", "label": "--surface-slide-dark", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-deep (#142447). The only dark slide surface in the system; carries data-surface=\"dark\" contexts such as the endorsement mark on dark."}, {"id": "colors_semantic_surface_card", "label": "--surface-card", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-snow. Card surface on light slides."}, {"id": "colors_semantic_surface_table_head", "label": "--surface-table-head", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-snow. Deliberately the same raw tint as --surface-card: a table header is just another card surface, so no new value is introduced."}, {"id": "colors_semantic_accent_structure", "label": "--accent-structure", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-sky. Naming the alias 'structure' is what enforces the sky-vs-teal split at the component level."}, {"id": "colors_semantic_accent_state", "label": "--accent-state", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-teal. Naming the alias 'state' is what enforces the sky-vs-teal split at the component level."}, {"id": "colors_semantic_text_heading", "label": "--text-heading", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-primary. Applied to display and slide-title type; the wordmark overrides it locally to colour the logo."}, {"id": "colors_semantic_text_body", "label": "--text-body", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-ink. Body copy runs at full opacity ink; the system has no dimmed body variant."}, {"id": "colors_semantic_text_invert", "label": "--text-invert", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-white. Text colour on the deep surface, where the pairing measures 14:1."}, {"id": "colors_semantic_text_caption", "label": "--text-caption", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-ink, i.e. the SAME raw value as --text-body. Captions are separated by size (18px), never by greying the text down -- which is exactly the failure the no-grey-on-white rule forbids."}, {"id": "colors_semantic_rule_hairline", "label": "--rule-hairline", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> snow-line. The only separator token; every card border and table rule goes through it."}, {"id": "colors_semantic_focus_ring", "label": "--focus-ring", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic alias -> brand-sky. Focus is treated as structure (an affordance), not as state, which is why it takes sky and not teal."}, {"id": "colors_semantic_alias_rule", "label": "Rule: components reference semantic aliases, never the raw palette", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve aliases sit between components and the four raw brand values. The indirection is the point: a component that asks for --surface-card cannot accidentally re-purpose a brand colour, and the palette can be retuned in one place."}], "edges": [{"source": "colors_semantic_surface_slide", "target": "colors_surfaces_brand_white", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/colors-semantic.html", "source_location": null, "weight": 1.0}, {"source": "colors_semantic_surface_slide_dark", "target": "colors_brand_deep", "relation": "references", "confidence": "EXTRACTED", "confid