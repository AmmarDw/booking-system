{"nodes": [{"id": "dsprompt_design_brief", "label": "Claude Design prompt #1 \u2014 design system brief", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L1-146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paste-in prompt for a new Design System project: the Arabic RTL-only design system for the SAG Lab bootcamp deck, to be read back into the repo via DesignSync."}, {"id": "dsprompt_component_spec", "label": "Spec of 20 named components (9 frames + 11 elements)", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L91-122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each must be built as a named, reusable component \u2014 not 'a set of ready components'."}, {"id": "ds_content_budget", "label": "Per-slide length budget (<=7 bullets, <=90 words, <=8 rows)", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L128-130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If content exceeds the budget the design must break it into \u0661/\u0662 and \u0662/\u0662 continuation slides \u2014 never shrink the type and never allow a scrollbar."}, {"id": "dsprompt_project_type_fixed", "label": "Design System project type is fixed at creation", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L5-10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project type cannot be changed later and only a Design System project can be read back into the repo; a normal project means starting over. Start template 'Color + type pairing' (fallback 'Blank'); never 'Slides' \u2014 only the components slides are built from are wanted."}, {"id": "dsprompt_copy_form_answers", "label": "Copy Claude Design form answers back verbatim", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L12-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude only knows what is in the prompt; anything decided in Claude Design's question form is invisible and would be assumed noise and dropped at build time unless pasted back into the chat."}, {"id": "dsprompt_designsync_readback", "label": "DesignSync reads the system into the repo (no command)", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L15-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude reads the finished components into the repo itself via the DesignSync tool, with no command from the trainer. /design-sync is the opposite direction: it uploads an existing code library to Claude Design, which is not what this is."}, {"id": "dsprompt_rtl_default", "label": "Arabic RTL-only; Latin fragments bidi-wrapped", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L25-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTL is the default and only direction, not a variant: every component authored dir=rtl, text aligned to start, mirrored layouts. Latin fragments (Claude Code, MVP, MCP, GitHub, Vercel, Supabase, paths, shell commands) sit inline inside Arabic and must be wrapped so a Latin token never flips the line."}, {"id": "dsprompt_logical_properties", "label": "CSS logical properties, no left/right in flow", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L30-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "margin-inline-start, padding-inline-end, border-inline-start, text-align:start; only genuinely directional things (a forward chevron) may be physical, and they mirror."}, {"id": "dsprompt_fixed_16x9", "label": "Fixed 16:9 frame; nothing scrolls inside a slide", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L33-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is a presentation deck, not a web page: every slide is a fixed 16:9 frame that fits entirely on screen, designed to a fixed height budget."}, {"id": "dsprompt_self_contained", "label": "Self-contained HTML/CSS; only Google Fonts external", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dsprompt_brand_marks", "label": "Two marks: \u0633\u0627\u062c \u0644\u0627\u0628 (lead) and SAG TECH (endorsing)", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L37-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different marks, not variants. \u0633\u0627\u062c \u0644\u0627\u0628: heavy navy calligraphic two-line Arabic wordmark, no icon, used large on title and divider slides. SAG TECH: circular navy monogram (white spiral reading as S) plus bold Latin caps and Kufi Arabic beneath, used small in the footer as the endorsement."}, {"id": "dsprompt_logo_zone", "label": "Logo zone: hero / standard / footnote sizes", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L48-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three sizes with enforced clear-space equal to the monogram's radius; never on a busy background."}, {"id": "dsprompt_color_tokens", "label": "Color tokens (primary, deep, sky, snow, ink, teal)", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L51-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--brand-primary #223A71 navy headings and marks; --brand-deep #142447 dark surfaces and cover; --brand-sky #38B6D9 structure (rules, buttons, technical accents); --brand-snow #EEF2F8 cards and sections; --brand-white #FFFFFF; --brand-ink #333B48 body copy; --brand-teal #16C7B7 state only (active step, completed, progress)."}, {"id": "dsprompt_sky_vs_teal", "label": "Sky = structure, teal = state; never mixed", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L63-64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sky and teal are close in hue, so they must never carry the same meaning on one slide."}, {"id": "dsprompt_surfaces", "label": "Light default surface + dark surface", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L66-67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light (white/snow, ink text) is the default; dark (--brand-deep, white text, sky accents) is for the title, section dividers and the closing slide."}, {"id": "dsprompt_typography_scale", "label": "Type scale sized for the back of the room", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L76-89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "display 64-72px, slide-title 40-44, section-number 20, body-lead 28-30, body 22-24 (never below 22), caption 18, mono 20 (IBM Plex Mono, forced LTR). Arabic line-height 1.7-1.8 because ascenders and diacritics collide at tighter settings. Projector legibility is the most common failure in decks."}, {"id": "dsprompt_cairo_font", "label": "Cairo for Arabic and Latin alike", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L71-74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One family for Arabic and the Latin fragments so mixed lines share one skeleton and never shift weight mid-sentence; Cairo is a variable font (200-1000), one file per unicode subset covers every weight; real fallback stack ending in a system Arabic face."}, {"id": "dsprompt_layout_rules", "label": "Layout rules: 5% margins, one idea, media >= 55%", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L124-132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe margins of at least 5% (projectors crop edges); one idea and one heading per slide (two headings = two slides); media slides give the image >= 55% of the frame and text supports it."}, {"id": "dsprompt_step_highlight", "label": "Visible focus/step highlight state", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So the presenter can point at one item without any animation."}, {"id": "dsprompt_do_not_want", "label": "What not to do: decoration, grey text, animation", "file_type": "rationale", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L134-140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No stock photography, gradients-as-decoration or shadows heavier than a 2px lift; icons are line, 2px, rounded caps matching the monogram; no light grey text on white (a projector eats contrast); no animation-dependent meaning \u2014 the deck must read as static frames."}, {"id": "dsprompt_deliverable", "label": "Deliverable: tokens, scales, 20 components with states", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L142-146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colour tokens, type scale, spacing scale and the 20 named components, each with states, documented so Claude can read them into the repo via DesignSync."}, {"id": "dsprompt_slide_title", "label": "slide-title \u2014 cover frame", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hero wordmark, program name, presenter block, endorsement mark."}, {"id": "dsprompt_slide_section", "label": "slide-section \u2014 divider, dark surface", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Announces a new curriculum section: big number plus Arabic title."}, {"id": "dsprompt_slide_content", "label": "slide-content \u2014 heading + up to 7 bullets", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The workhorse frame."}, {"id": "dsprompt_slide_split", "label": "slide-split \u2014 two columns", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E.g. 'what you read' / 'what Claude reads'."}, {"id": "dsprompt_slide_media", "label": "slide-media \u2014 media-dominant frame", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L101-102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most important frame in the deck; section 7.10 is built almost entirely from it. Large screenshot/GIF frame plus one short instruction line."}, {"id": "dsprompt_slide_steps", "label": "slide-steps \u2014 numbered sequence of 3-6", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each step with an optional small thumbnail."}, {"id": "dsprompt_slide_table", "label": "slide-table \u2014 compact table, max 8 rows", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Header row in --brand-snow."}, {"id": "dsprompt_slide_quote", "label": "slide-quote \u2014 single emphasised statement", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A statement or warning, centred."}, {"id": "dsprompt_slide_closing", "label": "slide-closing \u2014 end of day", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What was accomplished and what is next."}, {"id": "dsprompt_presenter_block", "label": "presenter-block \u2014 circular photo + name", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~180px photo with a 2px --brand-sky ring on dark surfaces, name and role lines."}, {"id": "dsprompt_section_badge", "label": "section-badge \u2014 pill \u00ab\u0627\u0644\u0642\u0633\u0645 7.10\u00bb", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L110-111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links the slide to the curriculum; every content slide carries one \u2014 how a trainee finds the slide again in the guide."}, {"id": "dsprompt_media_frame", "label": "media-frame \u2014 rounded container for media", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L112-113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounded, subtly shadowed, optional caption and numbered callout dot overlay for pointing at UI."}, {"id": "dsprompt_step_chip", "label": "step-chip \u2014 numbered circle with 3 states", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "upcoming / active (--brand-teal) / done."}, {"id": "dsprompt_timing_pill", "label": "timing-pill \u2014 duration pill", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows a duration such as \u00ab\u0662\u0665 \u062f\u0642\u064a\u0642\u0629\u00bb on agenda slides."}, {"id": "dsprompt_skill_card", "label": "skill-card \u2014 one acquired skill", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Icon slot plus one line of Arabic; used in a grid."}, {"id": "dsprompt_agenda_row", "label": "agenda-row \u2014 one row of the daily schedule", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session name, duration, what happens."}, {"id": "dsprompt_file_tree", "label": "file-tree \u2014 monospace directory tree", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L118-119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forced LTR (dir=ltr) because box-drawing characters and paths mirror badly under RTL, with Arabic annotations right-aligned beside it."}, {"id": "dsprompt_callout", "label": "callout \u2014 inline note in three tones", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Info (sky), warning (amber), rule (teal)."}, {"id": "dsprompt_day_progress", "label": "day-progress \u2014 which of 10 days is active", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent indicator of the active day and the position within it."}, {"id": "dsprompt_footer_bar", "label": "footer-bar \u2014 endorsement, day, slide number", "file_type": "document", "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries the SAG TECH endorsement mark, the day number and the slide number."}], "edges": [{"source": "dsprompt_component_spec", "target": "dsprompt_slide_title", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_content", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_media", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_steps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_quote", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_slide_closing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_presenter_block", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_section_badge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_media_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deck/DESIGN_SYSTEM_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "dsprompt_component_spec", "target": "dsprompt_step_chip", "relation": "references", "confidence": "EXTRACTED", "c