{"nodes": [{"id": "elevation_radius_sm", "label": "radius-sm (8px)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smallest corner radius, for tight elements and inline chips."}, {"id": "elevation_radius_md", "label": "radius-md (14px)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default card radius -- the value most cards and callouts in the system use."}, {"id": "elevation_radius_lg", "label": "radius-lg (24px)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large radius for full-bleed panels and hero blocks."}, {"id": "elevation_radius_pill", "label": "radius-pill (999px)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fully rounded, for badges, tags, and progress bars such as the teal state pills."}, {"id": "elevation_radius_scale", "label": "Radius scale (sm / md / lg / pill)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four fixed radii -- 8 / 14 / 24 / 999px. A closed set, so nothing in the deck invents an in-between corner."}, {"id": "elevation_lift_1", "label": "--lift-1", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lighter of the two shadows. Depth is carried mainly by the hairline border; the shadow only hints at separation."}, {"id": "elevation_lift_2", "label": "--lift-2", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The heaviest shadow the system owns -- the ceiling, not a mid step."}, {"id": "elevation_max_lift_rule", "label": "Rule: max 2px lift", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Max 2px lift. Nothing heavier exists in this system.' Only two shadow tokens exist, so a designer cannot escalate depth; hierarchy has to come from surface colour, radius, and the hairline rule instead. Heavy shadows also smear on a projector."}], "edges": [{"source": "elevation_radius_sm", "target": "elevation_radius_scale", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "weight": 1.0}, {"source": "elevation_radius_md", "target": "elevation_radius_scale", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "weight": 1.0}, {"source": "elevation_radius_lg", "target": "elevation_radius_scale", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/elevation.html", "source_location": null, "weight": 1.0}, {"source": "elevation_radius_pill", "target": "elevation_radius_scale", "relation": "conceptually_rel