ull, "author": null, "contributor": null}, {"id": "og_tags_img_link_preview_card", "label": "Link preview card (thumbnail + headline + site name)", "file_type": "rationale", "source_file": "project-package/slides/assets/Open-Graph-tags.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each platform card repeats the same three parts: a thumbnail image, a headline (You're Headline Here) and a site/domain line (WEBSITENAME.COM or your-url.com). Layout differs per platform: Facebook shows a large full-width image above the headline; LinkedIn shows a compact card with a small thumbnail beside the headline and a '1 min read' hint. All names and text in the mock-up are placeholders (Katie, #tagOne, https://enter-url), so the image is a generic illustration, not a screenshot of a real site."}], "edges": [{"source": "og_tags_img_open_graph_tags_png", "target": "og_tags_img_open_graph_tester", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/slides/assets/Open-Graph-tags.png", "source_location": null, "weight": 1.0}, {"source": "og_tags_img_open_graph_tags_png", "target": "og_tags_img_open_graph_metadata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/slides/assets/Open-Graph-tags.png", "source_location": null, "weight": 1.0}, {"source": "og_tags_img_open_graph_tester", "target": "og_tags_img_facebook_preview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/slides/assets/Open-Graph-tags.png", "source_location": null, "weight": 1.0}, {"source": "og_tags_img_open_graph_tester", "target": "og_tags_img_linkedin_preview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/slides/assets/Open-Graph-tags.png", "source_location": null, "weight": 1.0}, {"source": "og_tags