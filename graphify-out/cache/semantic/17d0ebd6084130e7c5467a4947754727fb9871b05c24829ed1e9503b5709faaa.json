{"nodes": [{"id": "application_yaml", "label": "Backend application.yaml", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L1-68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single config surface; every secret is env-var-bound with a dev-safe default so the same file works locally and on Render."}, {"id": "application_server_port", "label": "server.port: ${PORT:8080}", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L1-4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comment: Render and most PaaS hosts inject PORT and require the app to bind to it; 8080 is the local fallback where PORT is unset."}, {"id": "application_datasource", "label": "spring.datasource url/username/password (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L9-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every part of the JDBC URL is env-overridable with local defaults (localhost:5432/booking_system, user bookingadmin); the password default is empty so a real value must come from the environment. Password value redacted/not in source."}, {"id": "application_ddl_auto_validate", "label": "spring.jpa.hibernate.ddl-auto: validate", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L13-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hibernate is forbidden from mutating the schema; it only checks that entities match what the migrations produced."}, {"id": "application_flyway", "label": "spring.flyway.locations: classpath:db/migration + baseline-on-migrate: true", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L17-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flyway is the sole owner of schema evolution; baseline-on-migrate lets migrations run against a database that already has objects but no Flyway history table."}, {"id": "application_show_sql_false", "label": "spring.jpa.show-sql: false", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL logging off by default to keep production logs readable."}, {"id": "application_mvc_throw_no_handler", "label": "spring.mvc.throw-exception-if-no-handler-found: true", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L20-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes an unmatched route raise an exception the global handler can turn into a clean JSON 404 instead of Spring's default whitelabel/static fallthrough."}, {"id": "application_web_add_mappings_false", "label": "spring.web.resources.add-mappings: false", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L22-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disables the static-resource handler so unknown paths do not get swallowed by the resource resolver; pairs with throw-exception-if-no-handler-found to make 404s real."}, {"id": "application_mail_host_port", "label": "spring.mail host/port (EMAIL_HOST default smtp.gmail.com, EMAIL_PORT default 465)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L25-27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gmail SMTP on 465 chosen as the confirmation-email transport; both host and port stay env-overridable."}, {"id": "application_mail_credentials", "label": "spring.mail username/password (EMAIL_USER / EMAIL_PASS)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L28-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gmail account + app password supplied only via environment; defaults are empty strings. Values redacted/not in source."}, {"id": "application_mail_smtp_auth", "label": "[mail.smtp.auth]: true (bracket-quoted YAML key)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L30-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaMail property names contain dots, so they must be written as bracket-quoted single keys rather than nested YAML maps or Spring will not pass them through."}, {"id": "application_mail_ssl_enable", "label": "[mail.smtp.ssl.enable]: true (implicit SSL, not STARTTLS)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L32-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit comment: port 465 is implicit SSL, not STARTTLS on 587 - this property, not starttls.enable, is what makes JavaMail use SSL for the initial connection."}, {"id": "application_mail_timeouts", "label": "SMTP timeouts: connectiontimeout / timeout / writetimeout = 10000 ms", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L35-40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit comment: JavaMail has no default timeout, so a slow/hanging Gmail connection would block the booking thread forever; EmailService's try-catch cannot fire until the socket actually throws."}, {"id": "application_booking_max_horizon_months", "label": "booking.max-horizon-months: 6 (seed default)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L42-45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seed value only - the admin's live booking horizon is persisted in the single-row AppSettings table and overrides this at runtime (FR-14/FR-15)."}, {"id": "application_booking_provider_advance_multiplier", "label": "booking.provider-advance-multiplier: 1.5 (not admin-facing)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L46-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Providers may pre-load availability further ahead than consumers can book; advance limit = ceil(max-horizon-months * multiplier). Deliberately yaml-only so admins cannot change it from the UI."}, {"id": "application_appsettings_table", "label": "AppSettings single-row table (runtime override of booking policy)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L42-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated single-row table (not a generic key/value store) holds the admin's live horizon so it survives restarts and applies immediately."}, {"id": "application_emailservice", "label": "EmailService (named in the SMTP timeout comment)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L36-37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Referenced by the config comment as the component whose try-catch depends on the socket timeouts to ever fire."}, {"id": "application_google_oauth_credentials", "label": "google.client-id / google.client-secret (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L50-54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bound early (M6, FR-6/FR-13) even before the provider-onboarding controller existed; comment notes it is safe to bind now. Values redacted/env-only, defaults empty."}, {"id": "application_google_redirect_uri", "label": "google.redirect-uri (GOOGLE_REDIRECT_URI, default http://localhost:8080/api/google/oauth2/callback)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local default points at the dev backend so the OAuth loop works without env setup; production value comes from the Render Blueprint."}, {"id": "application_google_scope", "label": "google.scope: calendar.events + userinfo.email", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L56-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit comment: calendar.events creates/manages the Meet-enabled event; userinfo.email exists purely so the UI can show which Google account is connected."}, {"id": "application_google_token_encryption_key", "label": "google.token-encryption-key (TOKEN_ENCRYPTION_KEY)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-provider Google refresh tokens are stored encrypted at rest, so a separate key is needed beyond the JWT secret. Value redacted/env-only."}, {"id": "application_jwt_secret", "label": "app.jwt.secret (JWT_SECRET)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L61-64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signing key for the M2 JWT bearer auth; env-only with an empty default. Value redacted/not in source."}, {"id": "application_jwt_expiration_ms", "label": "app.jwt.expiration-ms: 86400000 (24h)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "24-hour session length - long enough that a demo run never gets logged out mid-flow."}, {"id": "application_cors_allowed_origins", "label": "app.cors.allowed-origins (APP_CORS_ORIGINS, default http://localhost:3000)", "file_type": "code", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L66-67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split frontend/backend deployment means CORS must be explicitly allowed; the default matches the Next.js dev server so local dev needs no env var."}, {"id": "application_fr14_fr15", "label": "FR-14 / FR-15 (admin-configurable booking horizon)", "file_type": "document", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L42-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requirement IDs cited directly in the config comment, tying the booking keys back to the SRS."}, {"id": "application_fr6_fr13", "label": "FR-6 / FR-13 (Google Calendar / Meet link generation, milestone M6)", "file_type": "document", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L50-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requirement IDs cited in the google block comment."}, {"id": "concept_flyway_owns_schema", "label": "Flyway owns the schema; Hibernate only validates", "file_type": "rationale", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L13-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations are the single source of truth for DDL; ddl-auto: validate turns any entity/schema drift into a startup failure rather than a silent auto-alter."}, {"id": "concept_booking_window_policy", "label": "Two-window booking policy (consumer horizon vs provider advance limit)", "file_type": "rationale", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L42-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumers book within [today, today+horizon] while providers may pre-load availability up to ceil(horizon*multiplier) ahead, so the rolling window always has slots ready to become bookable."}, {"id": "concept_json_only_error_surface", "label": "JSON-only error surface (no static fallthrough, no whitelabel page)", "file_type": "rationale", "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L20-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure API backend consumed by a separate Next.js frontend should never answer with HTML; disabling resource mappings and forcing no-handler exceptions guarantees every miss is a JSON error."}], "edges": [{"source": "application_server_port", "target": "render_bookit_backend", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L1-4", "weight": 1.0}, {"source": "application_yaml", "target": "application_server_port", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/backend/src/main/resources/application.yaml", "source_location": "L3-4", "weight": 1.0}, {"source": "application_yaml", "target": "application_datasource", "relation": "references", "confidence": "EXTRACTED", "con