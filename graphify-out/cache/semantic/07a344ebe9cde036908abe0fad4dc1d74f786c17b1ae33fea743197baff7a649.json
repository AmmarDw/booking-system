{"nodes": [{"id": "bootcampdeck_template", "label": "Bootcamp day deck template", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A four-slide RTL starting deck (cover, content, media, closing) laid out as stacked artboards on one canvas so a trainer can duplicate a real day and edit it visually instead of writing slide code."}, {"id": "bootcampdeck_cover_artboard", "label": "Artboard 01 - cover", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark-surface cover with the hero stacked wordmark, program display, day line and a presenter block that ships with a photo placeholder so the slot is visible before a real photo exists."}, {"id": "bootcampdeck_content_artboard", "label": "Artboard 02 - content slide", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static markup of the head (badge, title, rule, lead) plus a bullet list and a Callout, with the same section 7.10 sample the React content frame uses."}, {"id": "bootcampdeck_media_artboard", "label": "Artboard 03 - media slide", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Media frame plus a side instruction column, badged as a task (14.1) rather than a section - the task badge is what marks a hands-on slide."}, {"id": "bootcampdeck_closing_artboard", "label": "Artboard 04 - end of day", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark surface, two labelled groups: done skill cards in a single-column grid for accomplishments, plain bullets for tomorrow."}, {"id": "bootcampdeck_dclogic", "label": "DCLogic component + props panel", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes showProgress / activeDay / totalDays / withinDay as editor controls grouped under a Footer section and derives a single progressNode from them, so the trainer retargets the deck to another day from the properties panel instead of editing four footers by hand."}, {"id": "bootcampdeck_lucide_loader", "label": "Idempotent Lucide icon loader", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "componentDidMount injects the Lucide UMD script guarded by a fixed element id and forces one re-render on load - the canvas editor can mount the component many times, so the guard prevents duplicate script tags while still guaranteeing icons appear."}, {"id": "bootcampdeck_footerbar", "label": "FooterBar element", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent slide chrome carrying day, slide number and an optional progress node - present on every artboard so orientation never depends on the slide body."}, {"id": "bootcampdeck_sectionbadge", "label": "SectionBadge element", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kind + number pair (section or task) that ties each slide back to a curriculum coordinate."}, {"id": "bootcampdeck_callout", "label": "Callout element", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toned box (rule tone) for the one instruction on a slide that must not be skimmed past."}, {"id": "bootcampdeck_mediaframe", "label": "MediaFrame element", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships with an Arabic placeholder string describing the screenshot to capture plus a caption slot, so the shotlist is authored inside the slide before the real image exists."}, {"id": "bootcampdeck_skillcard", "label": "SkillCard element", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Icon + text card with a state (done) laid out in a column grid - the accomplishment unit of the closing slide."}, {"id": "bootcampdeck_dayprogress", "label": "DayProgress element", "file_type": "code", "source_file": "SAG Lab Design System/Floders/templates/bootcamp-deck/BootcampDeck.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows position across the ten-day program and within the current day, which is why it lives in the 