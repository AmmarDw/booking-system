{"nodes": [{"id": "type_scale_caption", "label": "caption (18px / 400)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-caption-mono.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labels and footnotes -- the only role allowed below the 22px body floor. It buys that exemption by staying full-opacity brand-ink: smaller, never greyer."}, {"id": "type_scale_mono", "label": "mono (20px / 400, IBM Plex Mono, forced LTR)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-caption-mono.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands and paths. 20px IBM Plex Mono in brand-primary on a snow block, always dir=\"ltr\" -- a shell command reordered by the RTL algorithm would be wrong, not merely ugly."}, {"id": "type_caption_mono_font_mono", "label": "--font-mono (IBM Plex Mono)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-caption-mono.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Companion monospace face, matched to IBM Plex Sans Arabic. Used for commands, paths, token names, and hex values -- everything that must be read literally, and therefore everything that is forced dir=\"ltr\"."}], "edges": [{"source": "type_scale_caption", "target": "type_font_arabic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-caption-mono.html", "source_location": null, "weight": 1.0}, {"source": "type_scale_mono", "target": "type_caption_mono_font_mono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-caption-mono.html", "source_location": null, "weight": 1.0