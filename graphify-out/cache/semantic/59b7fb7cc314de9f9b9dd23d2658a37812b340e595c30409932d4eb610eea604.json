{"nodes": [{"id": "colors_warning_state_warning", "label": "--state-warning (#A96504)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only amber in the system, and an explicit addition to the brand palette -- added solely because callout(warning) needs an amber tone. Deliberately dark enough (#A96504, not a bright yellow) to hold white text and to survive a projector."}, {"id": "colors_warning_state_warning_soft", "label": "--state-warning-soft (#FBF0DC)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tinted fill for the warning callout body, paired with the strong amber on the leading edge. Keeps the callout readable in ink while still reading as a warning."}, {"id": "colors_warning_callout_pattern", "label": "Warning callout pattern", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft amber fill + a 6px border-inline-start in the strong amber + a bold amber label. The accent bar uses the logical inline-start edge so it flips automatically under RTL/LTR rather than being pinned left."}], "edges": [{"source": "colors_warning_callout_pattern", "target": "colors_warning_state_warning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "weight": 1.0}, {"source": "colors_warning_callout_pattern", "target": "colors_warning_state_warning_soft", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "weight": 1.0}, {"source": "colors_warning_callout_pattern", "target": "rtl_logical_properties_rule", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "weight": 1.0}, {"source": "colors_warning_state_warning_soft", "target": "rtl_logical_brand_teal_soft", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "SAG Lab Design System/Floders/guidelines/colors-warning.html", "source_location": null, "weight": 1.0}], "hyperedges": []}