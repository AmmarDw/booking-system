{"nodes": [{"id": "concept_rtl_arabic_support", "label": "RTL / Arabic support baked into the design tokens", "file_type": "rationale", "source_file": "app/frontend/src/components/ds/README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typography tokens ship an RTL font swap (IBM Plex Sans Arabic alongside Inter) so direction changes do not require per-component overrides."}, {"id": "concept_design_system_first", "label": "Design-System-first outcome (components over per-screen mockups)", "file_type": "rationale", "source_file": "app/frontend/src/components/ds/README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 4 reference screens exist rather than one per page; remaining pages are composed from the shared components, which the README calls the intended outcome."}, {"id": "dsreadme_bookit_design_system", "label": "BookIt Design System (pulled from Claude Design via DesignSync)", "file_type": "document", "source_file": "app/frontend/src/components/ds/README.md", "source_location": "L1-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synced component library rather than hand-written CSS, so design tokens stay the single source of truth shared with the Claude Design project."}, {"id": "dsreadme_tokens_colors", "label": "tokens/colors.css (teal primary + availability-pressure scale + light/dark)", "file_type": "code", "source_file": "app/frontend/src/components/ds/README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The availability-pressure scale is a first-class token family so calendar pressure colors are derived from the palette instead of disrupting it."}, {"id": "dsreadme_tokens_typography", "label": "tokens/typography.css (Inter + IBM Plex Sans Arabic, RTL font swap)", "file_type": "co