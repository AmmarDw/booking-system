{"nodes": [{"id": "skill_writing_requirements", "label": "Skill: writing-requirements (section 10, tasks 10.1-10.3)", "file_type": "document", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "frontmatter + full body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trainee supplies free-form notes; Claude formalises them to EARS/Gherkin standards and the trainee only reviews."}, {"id": "skill_task_10_1_gather_notes", "label": "Task 10.1 - elicit notes, not requirements (incl. unhappy paths)", "file_type": "document", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_10_2_functional_requirements", "label": "Task 10.2 - draft the functional requirements and iterate", "file_type": "document", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_10_3_nfrs", "label": "Task 10.3 - propose non-functional requirements unprompted", "file_type": "document", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_standard_ears_syntax", "label": "Standard: EARS patterns (ubiquitous / event-driven / state-driven / unwanted behaviour)", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requirements are never written in plain prose; shall = mandatory, should = desirable, will = a statement of fact and not a requirement."}, {"id": "skill_rule_flat_requirement_ids", "label": "Rule: flat numeric IDs FR-1 / NFR-1, never nested ones like HOME-NAV-001", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 1 identifiers", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_format_gherkin_acceptance_criteria", "label": "Format: Gherkin acceptance criteria (Given / When / Then) on every requirement", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each requirement is written complete in one place (EARS + user story + acceptance criteria + priority); tables are only an index of id and title."}, {"id": "skill_check_requirement_four_properties", "label": "Quality gate: necessary, atomic, verifiable, clear", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_warning_conflict_check_before_proposing", "label": "Warning: check a self-proposed rule against earlier decisions before showing it", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It really happened: an automatic skip-the-weekend rule was proposed although an earlier requirement let the provider choose his own working days; it was caught only because the trainer read the suggestion against what had been agreed. Always state where a proposed requirement was derived from, and name the conflict instead of stepping over it silently."}, {"id": "skill_rule_propose_nfrs_unprompted", "label": "Rule: propose NFRs without being asked - the trainee never will", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even the trainer, a software engineer, did not notice they were missing; they were written because the standard demands them. Every NFR needs a metric - 'fast' is a wish, 'within two seconds' is a requirement."}, {"id": "skill_baseline_security_minimum", "label": "Non-negotiable baseline: hashed passwords, secrets in env vars not in the repo", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_rule_redundancy_control", "label": "IA rule: the summary location holds a preview, the dedicated section holds the full data", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_mistake_all_priorities_ten", "label": "Mistake list: requirement restates a scope item, untestable criteria, every priority 10/10, two behaviours in one requirement, NFR with no number", "file_type": "rationale", "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scope says what we build, a requirement says how the system behaves."}], "edges": [{"source": "skill_writing_requirements", "target": "skill_task_10_1_gather_notes", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/writing-requirements/SKILL.md", "source_location": "section 5.1", "weight": 1.0}, {"sourc