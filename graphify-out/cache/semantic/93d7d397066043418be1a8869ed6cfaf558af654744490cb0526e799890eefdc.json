{"nodes": [{"id": "type_scale_body_lead", "label": "body-lead (29px / 500)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one main line of a slide. 29px, weight 500, line-height 1.7 -- one step up from body so the key sentence is found before the bullets."}, {"id": "type_scale_body", "label": "body (23px / 400)", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bullets and cards. 23px regular, line-height 1.75, measure capped around 52ch. The 1.75 leading is required for Arabic diacritics, and the 23px size sits above the 22px projector floor."}, {"id": "type_body_min_size_rule", "label": "Rule: body never below 22px", "file_type": "rationale", "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hard floor for body copy on slides -- 23px body sits just above it. Prevents the usual fix of shrinking type to fit more content; the content has to be cut instead."}], "edges": [{"source": "type_scale_body_lead", "target": "type_font_arabic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "weight": 1.0}, {"source": "type_scale_body", "target": "type_font_arabic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "weight": 1.0}, {"source": "type_body_min_size_rule", "target": "type_scale_body", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "weight": 1.0}, {"source": "type_body_min_size_rule", "target": "type_scale_caption", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "SAG Lab Design System/Floders/guidelines/type-body.html", "source_location": null, "weight": 1.0}], "hyperedges": []}