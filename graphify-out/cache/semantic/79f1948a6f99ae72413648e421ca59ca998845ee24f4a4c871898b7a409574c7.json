{"nodes": [{"id": "skill_testing_and_security", "label": "Skill: testing-and-security (section 15, tasks 15.1-15.3)", "file_type": "document", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "frontmatter + full body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-feature testing belongs to building-features; this round asks a different question - do the features work together, and is the unauthorised actor actually blocked."}, {"id": "skill_task_15_1_define_what_to_test", "label": "Task 15.1 - decide what gets tested, incl. state-reversing chains", "file_type": "document", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_15_2_integration_scenarios", "label": "Task 15.2 - integration scenarios across features", "file_type": "document", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_task_15_3_security_review", "label": "Task 15.3 - security review by real access attempts per role", "file_type": "document", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_principle_trainee_never_reads_code", "label": "Rule: never ask the trainee to read code, open a file, or run a test", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "He verifies through the UI and through Claude's plain-language report only."}, {"id": "skill_rule_report_non_technical", "label": "Rule: report in non-technical language, no function names or status codes", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 0", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_concept_chains_not_functions", "label": "Value of section 15: test chains, not single functions (create-edit-cancel, contention, dependency)", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real example: booking the same slot twice was rejected even under a different service of the same provider - invisible to a single-feature test, found only by a scenario crossing two services of one person. After a cancel, verify the state really returned (is the resource available again?)."}, {"id": "skill_table_mandatory_error_cases", "label": "Mandatory error cases: no login, bad input, missing resource, missing permission, repeated operation", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A product that works when everything goes right has not been tested yet."}, {"id": "skill_rule_browser_test_required", "label": "Rule: walk the journey in the browser via chrome-devtools, not from the CLI alone", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some defects exist only in what the user sees - the OS-language digits and month names showed up in no server-side check."}, {"id": "skill_rule_rerun_scenario_after_fix", "label": "Rule: after each fix rerun the scenario and say so in the report", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You do not know you fixed it until the scenario passes."}, {"id": "skill_warning_attempt_dont_claim", "label": "Warning: 'permissions are applied' is a claim, not a test result - attempt and report the outcome", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sign in as every role, actually try what must be blocked (including seeing another user's data within the same role) and write what happened: 'I signed in as a consumer and tried to open the admin page - I was blocked.'"}, {"id": "skill_rule_verify_security_basics", "label": "Rule: verify the basics - hashed passwords, keys in .env, .env gitignored, business rules server-side", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check them for real and state the result, because the trainee will not open a file to confirm."}, {"id": "skill_admission_reference_lacked_automated_tests", "label": "Honesty rule: admit the reference project never completed repeatable automated tests", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It relied on the CLI and the browser, which cost manual retesting after every change and left no guard against a fixed defect returning - that felt absence is exactly why writing them after each feature became the rule. Do not pretend otherwise if the trainee asks."}, {"id": "skill_gate_no_deploy_until_green", "label": "Gate: do not move to deployment while any scenario still fails - say so explicitly", "file_type": "rationale", "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skill_testing_and_security", "target": "skill_task_15_1_define_what_to_test", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 1", "weight": 1.0}, {"source": "skill_testing_and_security", "target": "skill_task_15_2_integration_scenarios", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2", "weight": 1.0}, {"source": "skill_testing_and_security", "target": "skill_task_15_3_security_review", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 3", "weight": 1.0}, {"source": "skill_testing_and_security", "target": "skill_concept_chains_not_functions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2.1", "weight": 1.0}, {"source": "skill_testing_and_security", "target": "skill_table_mandatory_error_cases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-package/.claude/skills/testing-and-security/SKILL.md", "source_location": "section 2.2", "weight": 1.0}, {"source": "skill_testing_and_security", "target": 