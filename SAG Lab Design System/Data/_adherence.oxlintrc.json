        "message": "<SectionBadge> tone must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|icon|iconNode|state|className|style|key|ref|className|style|children)$/]",
        "message": "<SkillCard> doesn't accept that prop. Declared props: text, icon, iconNode, state, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|done)$/]",
        "message": "<SkillCard> state must be one of 'default' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClosingSkill'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|icon|key|ref|className|style|children)$/]",
        "message": "<ClosingSkill> doesn't accept that prop. Declared props: text, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lead|bullets|focusIndex|badge|children|surface|day|slideNumber|progress|key|ref|className|style|children)$/]",
        "message": "<SlideContent> doesn't accept that prop. Declared props: title, lead, bullets, focusIndex, badge, children, surface, day, slideNumber, progress."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideContent'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SlideContent> surface must be one of 'light' | 'dark'."
