{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/elements/**",
              "components/frames/**",
              "slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Arabic|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Arabic, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|what|duration|state|className|style|key|ref|className|style|children)$/]",
        "message": "<AgendaRow> doesn't accept that prop. Declared props: name, what, duration, state, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active|done)$/]",
        "message": "<AgendaRow> state must be one of 'default' | 'active' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|children|icon|className|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, label, children, icon, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|warning|rule)$/]",
        "message": "<Callout> tone must be one of 'info' | 'warning' | 'rule'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:totalDays|activeDay|within|label|className|style|key|ref|className|style|children)$/]",
        "message": "<DayProgress> doesn't accept that prop. Declared props: totalDays, activeDay, within, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EndorsementMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|showText|className|style|key|ref|className|style|children)$/]",
        "message": "<EndorsementMark> doesn't accept that prop. Declared props: size, showText, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EndorsementMark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|standard|footnote)$/]",
        "message": "<EndorsementMark> size must be one of 'hero' | 'standard' | 'footnote'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileTree'] > JSXAttribute > JSXIdentifier[name!=/^(?:tree|notes|className|style|key|ref|className|style|children)$/]",
        "message": "<FileTree> doesn't accept that prop. Declared props: tree, notes, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|slideNumber|progress|showMark|className|style|key|ref|className|style|children)$/]",
        "message": "<FooterBar> doesn't accept that prop. Declared props: day, slideNumber, progress, showMark, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoZone'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|lines|showNote|className|style|key|ref|className|style|children)$/]",
        "message": "<LogoZone> doesn't accept that prop. Declared props: size, lines, showNote, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoZone'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|standard|footnote)$/]",
        "message": "<LogoZone> size must be one of 'hero' | 'standard' | 'footnote'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|x|y|key|ref|className|style|children)$/]",
        "message": "<MediaCallout> doesn't accept that prop. Declared props: n, x, y."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresenterBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|org|photo|alt|size|className|style|key|ref|className|style|children)$/]",
        "message": "<PresenterBlock> doesn't accept that prop. Declared props: name, role, org, photo, alt, size, className, style."
