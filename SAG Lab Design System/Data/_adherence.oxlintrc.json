      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|day|slideNumber|progress|footer|showMark|className|children|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: surface, day, slideNumber, progress, footer, showMark, className, children, style."
