        "message": "<SlideQuote> doesn't accept that prop. Declared props: text, attribution, tone, surface, day, slideNumber."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|warning|rule)$/]",
        "message": "<SlideQuote> tone must be one of 'default' | 'warning' | 'rule'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideQuote'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SlideQuote> surface must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|subtitle|surface|day|slideNumber|key|ref|className|style|children)$/]",
        "message": "<SlideSection> doesn't accept that prop. Declared props: number, title, subtitle, surface, day, slideNumber."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideSection'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SlideSection> surface must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|children|key|ref|className|style|children)$/]",
        "message": "<SplitColumn> doesn't accept that prop. Declared props: label, items, children."
      },
