        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:program|subtitle|presenter|surface|day|slideNumber|wordmarkLines|key|ref|className|style|children)$/]",
