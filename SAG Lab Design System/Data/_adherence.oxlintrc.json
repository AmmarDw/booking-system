        "selector": "JSXOpeningElement[name.name='PresenterBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|compact)$/]",
        "message": "<PresenterBlock> size must be one of 'default' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|number|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<SectionBadge> doesn't accept that prop. Declared props: kind, number, tone, className, style."
