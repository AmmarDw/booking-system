# IDE
.idea/
.vscode/

# Claude Code personal/local settings (machine-specific, not shared project config)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Personal scratch notes (not part of the project deliverables)
notebook.txt

# Nested projects manage their own build artifacts / secrets via their own .gitignore
# (app/backend/.gitignore, app/frontend/.gitignore)

# Word lock files (created while a .docx is open, deleted on close)
~$*

# Machine-specific: absolute path to the local Python interpreter
graphify-out/.graphify_python

# Transient backup of the previous graphify run
graphify-out/.chunks_prev_run/

# Distribution archives: byte-for-byte duplicates of tracked directories
# (LOGO_Sag/, project-package/). Committing them means a stale zip can be
# handed out after the folder has moved on — rebuild instead of tracking.
/LOGO_Sag.zip
/project-package.zip

# Oversized media: GitHub rejects any single file over 100 MiB on push.
# task-10.1.mp4 is 208.5 MB (roughly double the limit) — re-encode or move
# to Git LFS before ever removing this line.
project-package/slides/media/task-10.1.mp4

# Same 100 MiB problem, Day-4's two recordings: task-7.11.mp4 is 107.2 MiB,
# tasks-10.3-11.1-11.2.mp4 is 152.2 MiB — re-encode or move to Git LFS
# before ever removing this line.
project-package/slides/media/task-7.11.mp4
project-package/slides/media/tasks-10.3-11.1-11.2.mp4

# Same 100 MiB problem, Day-5's two recordings: tasks_12.1_12.2.mp4 is
# 181.3 MiB, tasks_12.3_12.4.mp4 is 198.8 MiB — re-encode or move to Git
# LFS before ever removing this line.
project-package/slides/media/tasks_12.1_12.2.mp4
project-package/slides/media/tasks_12.3_12.4.mp4
